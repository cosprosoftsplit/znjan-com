{
  "name": "znjan-com",
  "type": "module",
  "version": "0.1.0",
  "description": "Comprehensive beach portal for Znjan Beach, Split, Croatia",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "preview:runtime": "npx wrangler pages dev dist --compatibility-flag nodejs_compat --kv SESSION",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "check-i18n": "tsx scripts/check-i18n.ts",
    "check-refs": "tsx scripts/check-refs.ts",
    "check-links": "tsx scripts/check-links.ts",
    "check-output-seo": "tsx scripts/check-output-seo.ts",
    "audit:policy": "tsx scripts/check-audit.ts",
    "smoke:production": "tsx scripts/smoke-production.ts",
    "verify": "npm run check-i18n && npm run check-refs && npm run check && npm test && npm run build && npm run check-links && npm run check-output-seo && npm run test:e2e && npm run audit:policy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/tailwind": "^6.0.2",
    "@tailwindcss/typography": "^0.5.19",
    "astro": "^5.17.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.19",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vitest-pool-workers": "^0.18.5",
    "@playwright/test": "^1.61.1",
    "@types/qrcode": "^1.5.6",
    "pagefind": "^1.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
