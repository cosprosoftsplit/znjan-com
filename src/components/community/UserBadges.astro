---
import type { Language } from '@/lib/i18n';
import { t } from '@/lib/translations';
import { BADGES, type BadgeId } from '@/lib/gamification';

interface Props {
  lang: Language;
  badges: Array<{ badge_id: string; earned_at: string }>;
}

const { lang, badges } = Astro.props;
---

<div class="bg-white rounded-xl border border-warm-200 p-5">
  <h3 class="font-display text-lg text-ocean-900 mb-4">{t(lang, 'gamification.badges')}</h3>
  {badges.length === 0 ? (
    <p class="text-sm text-warm-400">{t(lang, 'gamification.noBadgesYet')}</p>
  ) : (
    <div class="grid grid-cols-2 gap-3">
      {badges.map((b) => {
        const badge = BADGES[b.badge_id as BadgeId];
        if (!badge) return null;
        return (
          <div class="flex items-center gap-2 p-2 rounded-lg bg-warm-50">
            <span class="text-2xl">{badge.icon}</span>
            <div>
              <div class="text-sm font-medium text-ocean-900">{badge.name}</div>
              <div class="text-xs text-warm-500">{badge.description}</div>
            </div>
          </div>
        );
      })}
    </div>
  )}
</div>
