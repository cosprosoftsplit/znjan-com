---
import Guide from '@/layouts/Guide.astro';
import { collectEntitySlugs, getAlternateUrls, getLocalized, getHreflangLinks, getLocalizedUrl } from '@/lib/i18n';
import type { Language } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';
import { canonicalUrl } from '@/lib/utils';
import { buildArticleSchema, buildBreadcrumbSchema, buildFAQSchema } from '@/lib/seo';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allGuides = await getCollection('guides');
  return allGuides.map((guide) => ({
    params: { lang: guide.data.lang, slug: guide.data.slugs[guide.data.lang] },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const lang = guide.data.lang as Language;
const translations = getTranslations(lang);

const title = getLocalized(guide.data.title, lang);
const description = getLocalized(guide.data.description, lang);
const translatedGuides = await getCollection(
  'guides',
  ({ data }) => data.guideId === guide.data.guideId,
);
const entitySlugs = collectEntitySlugs(translatedGuides.map(({ data }) => data));
const hreflangLinks = getHreflangLinks('guides', entitySlugs);
const alternates = getAlternateUrls('guides', entitySlugs);

// Related content links (same-language siblings, guarded against missing entities)
const allGuides = await getCollection('guides', ({ data }) => data.lang === lang);
const allActivities = await getCollection('activities');
const allBeachAreas = await getCollection('beach-areas');
const allPlaces = await getCollection('places');

const relatedLinks: Array<{ label: string; href: string }> = [];

for (const guideId of guide.data.relatedGuides) {
  const related = allGuides.find((g) => g.data.guideId === guideId);
  if (related) {
    relatedLinks.push({
      label: getLocalized(related.data.title, lang),
      href: getLocalizedUrl(lang, 'guides', related.data.slugs[lang]),
    });
  }
}

for (const activityId of guide.data.relatedActivities) {
  const related = allActivities.find((a) => a.data.id === activityId);
  if (related) {
    relatedLinks.push({
      label: getLocalized(related.data.title, lang),
      href: getLocalizedUrl(lang, 'activities', related.data.slug[lang]),
    });
  }
}

for (const areaId of guide.data.relatedBeachAreas) {
  const related = allBeachAreas.find((a) => a.data.id === areaId);
  if (related) {
    relatedLinks.push({
      label: getLocalized(related.data.title, lang),
      href: getLocalizedUrl(lang, 'beach-areas', related.data.slug[lang]),
    });
  }
}

for (const placeId of guide.data.relatedPlaces) {
  const related = allPlaces.find((p) => p.data.id === placeId);
  if (related) {
    relatedLinks.push({
      label: getLocalized(related.data.title, lang),
      href: getLocalizedUrl(lang, 'places', related.data.slug[lang]),
    });
  }
}

const structuredData: Record<string, unknown>[] = [
  buildArticleSchema({
    title,
    description,
    url: `https://znjan.com/${lang}/guides/${guide.data.slugs[lang]}/`,
    publishedAt: guide.data.publishedAt.toISOString(),
    updatedAt: guide.data.updatedAt.toISOString(),
    author: guide.data.author || 'Znjan.com Team',
  }),
  buildBreadcrumbSchema([
    { name: translations['nav.home'], url: `https://znjan.com/${lang}/` },
    { name: translations['nav.guides'], url: `https://znjan.com${getLocalizedUrl(lang, 'guides')}` },
    { name: title, url: `https://znjan.com/${lang}/guides/${guide.data.slugs[lang]}/` },
  ]),
];

if (guide.data.faqs?.length) {
  structuredData.push(buildFAQSchema(guide.data.faqs));
}

const { Content } = await guide.render();
---

<Guide
  title={title}
  description={description}
  lang={lang}
  translations={translations}
  alternates={alternates}
  canonicalUrl={canonicalUrl(`/${lang}/guides/${guide.data.slugs[lang]}/`)}
  hreflangLinks={hreflangLinks}
  structuredData={structuredData}
  publishedAt={guide.data.publishedAt}
  updatedAt={guide.data.updatedAt}
  author={guide.data.author || 'Znjan.com Team'}
  readingTime={guide.data.readingTime}
  cluster={guide.data.cluster}
  relatedLinks={relatedLinks}
>
  <Content />
</Guide>
