---
interface Props {
  href?: string;
  class?: string;
}

const { href, class: className } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class:list={[
    'block bg-white rounded-xl border border-sand-200 shadow-soft-sm overflow-hidden transition-all duration-300',
    href && 'hover:shadow-soft-lg hover:-translate-y-[3px]',
    className,
  ]}
>
  <slot />
</Tag>
