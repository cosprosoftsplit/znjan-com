---
export const prerender = false;

import Page from '@/layouts/Page.astro';
import type { Language } from '@/lib/i18n';
import { LANGUAGES, ROUTE_SEGMENTS } from '@/lib/i18n';
import { getTranslations, t } from '@/lib/translations';

const lang = Astro.params.lang as Language;
if (!LANGUAGES.includes(lang)) return Astro.redirect('/en/community/login/');

const translations = getTranslations(lang);
const user = Astro.locals.user;
if (user) return Astro.redirect(`/${lang}/community/`);

const errorParam = Astro.url.searchParams.get('error');
const privacyUrl = `/${lang}/${ROUTE_SEGMENTS.privacy[lang]}/`;
const contactUrl = `/${lang}/${ROUTE_SEGMENTS.contact[lang]}/`;
---

<Page
  title={t(lang, 'auth.loginTitle')}
  description={t(lang, 'auth.loginDescription')}
  lang={lang}
  translations={translations}
  noIndex={true}
>
  <div class="container-page py-16 max-w-md mx-auto">
    <div class="bg-white rounded-2xl shadow-lg p-8">
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-ocean-100 rounded-full mb-4">
          <svg class="w-8 h-8 text-ocean-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </div>
        <h1 class="text-2xl font-display text-ocean-900 mb-2">{t(lang, 'auth.loginTitle')}</h1>
        <p class="text-warm-600">{t(lang, 'auth.loginSubtitle')}</p>
      </div>

      {errorParam && (
        <div class="bg-coral-50 border border-coral-200 text-coral-800 px-4 py-3 rounded-lg mb-6 text-sm">
          {errorParam === 'invalid-token' ? t(lang, 'auth.errorInvalidToken') :
           errorParam === 'auth-cancelled' ? t(lang, 'auth.errorGeneric') :
           t(lang, 'auth.errorGeneric')}
        </div>
      )}

      <a
        href={`/api/auth/google?lang=${lang}`}
        class="flex items-center justify-center gap-3 w-full bg-white hover:bg-warm-50 border-2 border-warm-300 text-warm-800 font-semibold py-3 px-4 rounded-lg transition-colors duration-200"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        {t(lang, 'auth.signInWithGoogle')}
      </a>

      <p class="text-center text-warm-500 text-xs mt-6">{t(lang, 'auth.googleSignInDesc')}</p>

      <div class="mt-6 rounded-xl border border-warm-200 bg-warm-50 px-4 py-3 text-xs text-warm-700">
        <p>{t(lang, 'auth.privacyNote')}</p>
        <div class="mt-3 flex flex-wrap gap-3">
          <a href={privacyUrl} class="font-semibold text-ocean-700 hover:text-ocean-800 hover:underline">
            {translations['common.privacyPolicy'] || 'Privacy Policy'}
          </a>
          <a href={contactUrl} class="font-semibold text-ocean-700 hover:text-ocean-800 hover:underline">
            {translations['nav.contact'] || 'Contact'}
          </a>
        </div>
      </div>
    </div>
  </div>
</Page>
