---
export const prerender = false;

import Page from '@/layouts/Page.astro';
import Button from '@/components/ui/Button.astro';
import ReservationTrustPanel from '@/components/community/ReservationTrustPanel.astro';
import type { Language } from '@/lib/i18n';
import { LANGUAGES, ROUTE_SEGMENTS } from '@/lib/i18n';
import { getTranslations, t } from '@/lib/translations';

const lang = Astro.params.lang as Language;
if (!LANGUAGES.includes(lang)) return Astro.redirect('/en/community/reservations/rules/');

const translations = getTranslations(lang);
const alternates = Object.fromEntries(
  LANGUAGES.map((locale) => [locale, `/${locale}/community/reservations/rules/`]),
) as Record<Language, string>;

const rules = [
  t(lang, 'reservations.ruleFree'),
  t(lang, 'reservations.ruleWindow'),
  t(lang, 'reservations.ruleDuration'),
  t(lang, 'reservations.ruleDailyLimit'),
  t(lang, 'reservations.ruleCancellation'),
  t(lang, 'reservations.ruleNoShow'),
  t(lang, 'reservations.rulePublic'),
];

const fairnessPoints = [
  t(lang, 'reservations.fairnessPointPublic'),
  t(lang, 'reservations.fairnessPointSignin'),
  t(lang, 'reservations.fairnessPointClosures'),
];

const contactUrl = `/${lang}/${ROUTE_SEGMENTS.contact[lang]}/`;
---

<Page
  title={t(lang, 'reservations.rulesPageTitle')}
  description={t(lang, 'reservations.rulesPageDescription')}
  lang={lang}
  translations={translations}
  alternates={alternates}
>
  <section class="container-page py-10">
    <div class="max-w-4xl">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-ocean-600 mb-3">
        {t(lang, 'reservations.bookingRules')}
      </p>
      <h1 class="text-3xl md:text-5xl font-display text-ocean-900 mb-4">
        {t(lang, 'reservations.rulesPageTitle')}
      </h1>
      <p class="text-lg text-warm-600 max-w-3xl">
        {t(lang, 'reservations.rulesPageDescription')}
      </p>

      <div class="mt-6 flex flex-wrap gap-3">
        <Button href={`/${lang}/community/reservations/`} variant="primary" size="lg">
          {t(lang, 'reservations.backToSchedule')}
        </Button>
        <Button href={`/${lang}/play/`} variant="secondary" size="lg">
          {t(lang, 'reservations.quickStartTitle')}
        </Button>
        <Button href={contactUrl} variant="outline" size="lg">
          {t(lang, 'reservations.contactCta')}
        </Button>
      </div>
    </div>

    <div class="mt-6">
      <ReservationTrustPanel lang={lang} />
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6 mt-6">
      <article class="bg-white rounded-2xl border border-warm-200 p-6">
        <h2 class="text-xl font-semibold text-ocean-900 mb-4">{t(lang, 'reservations.bookingRules')}</h2>
        <ul class="space-y-3 text-sm text-warm-700">
          {rules.map((rule) => (
            <li class="rounded-xl border border-warm-100 bg-warm-50 px-4 py-3">{rule}</li>
          ))}
        </ul>
      </article>

      <article class="bg-white rounded-2xl border border-warm-200 p-6">
        <h2 class="text-xl font-semibold text-ocean-900">{t(lang, 'reservations.pilotInventoryTitle')}</h2>
        <p class="mt-3 text-sm leading-7 text-warm-700">
          {t(lang, 'reservations.pilotInventorySummary')}
        </p>
        <p class="mt-3 text-sm leading-7 text-warm-700">
          {t(lang, 'reservations.pilotInventoryNote')}
        </p>

        <h3 class="mt-6 text-lg font-semibold text-ocean-900">{t(lang, 'reservations.fairnessTitle')}</h3>
        <p class="mt-2 text-sm leading-7 text-warm-700">
          {t(lang, 'reservations.fairnessDescription')}
        </p>
        <ul class="mt-4 space-y-3 text-sm text-warm-700">
          {fairnessPoints.map((point) => (
            <li class="rounded-xl border border-ocean-100 bg-ocean-50 px-4 py-3">{point}</li>
          ))}
        </ul>
      </article>
    </div>

    <div class="bg-sand-50 rounded-2xl border border-sand-200 p-6 mt-6">
      <h2 class="text-xl font-semibold text-ocean-900">{t(lang, 'reservations.pilotFutureTitle')}</h2>
      <p class="mt-3 text-sm leading-7 text-warm-700">
        {t(lang, 'reservations.pilotFutureBody')}
      </p>
    </div>
  </section>
</Page>
