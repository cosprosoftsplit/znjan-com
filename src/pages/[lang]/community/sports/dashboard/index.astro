---
export const prerender = false;

import Page from '@/layouts/Page.astro';
import Button from '@/components/ui/Button.astro';
import ReservationTrustPanel from '@/components/community/ReservationTrustPanel.astro';
import type { Language } from '@/lib/i18n';
import { LANGUAGES, ROUTE_SEGMENTS } from '@/lib/i18n';
import { getTranslations, t } from '@/lib/translations';

const lang = Astro.params.lang as Language;
if (!LANGUAGES.includes(lang)) return Astro.redirect('/en/community/sports/dashboard/');

const translations = getTranslations(lang);
const alternates = Object.fromEntries(
  LANGUAGES.map((locale) => [locale, `/${locale}/community/sports/dashboard/`]),
) as Record<Language, string>;

const summaryCards = [
  t(lang, 'reservations.ruleFree'),
  t(lang, 'reservations.ruleWindow'),
  t(lang, 'reservations.ruleDailyLimit'),
];

const detailCards = [
  t(lang, 'reservations.ruleDuration'),
  t(lang, 'reservations.ruleCancellation'),
  t(lang, 'reservations.rulePublic'),
];

const contactUrl = `/${lang}/${ROUTE_SEGMENTS.contact[lang]}/`;
---

<Page
  title={t(lang, 'reservations.transparencyDashboardTitle')}
  description={t(lang, 'reservations.transparencyDashboardSubtitle')}
  lang={lang}
  translations={translations}
  alternates={alternates}
>
  <section class="container-page py-10">
    <div class="max-w-4xl">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-ocean-600 mb-3">
        {t(lang, 'reservations.transparencyTitle')}
      </p>
      <h1 class="text-3xl md:text-5xl font-display text-ocean-900 mb-4">
        {t(lang, 'reservations.transparencyDashboardTitle')}
      </h1>
      <p class="text-lg text-warm-600 max-w-3xl">
        {t(lang, 'reservations.transparencyDashboardSubtitle')}
      </p>

      <div class="mt-6 flex flex-wrap gap-3">
        <Button href={`/${lang}/community/sports/`} variant="primary" size="lg">
          {t(lang, 'reservations.backToSchedule')}
        </Button>
        <Button href={`/${lang}/community/sports/rules/`} variant="secondary" size="lg">
          {t(lang, 'reservations.rulesCta')}
        </Button>
        <Button href={contactUrl} variant="outline" size="lg">
          {t(lang, 'reservations.contactCta')}
        </Button>
      </div>
    </div>

    <div class="mt-6">
      <ReservationTrustPanel lang={lang} />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6">
      {summaryCards.map((card) => (
        <article class="rounded-2xl border border-warm-200 bg-white px-5 py-5">
          <p class="text-sm leading-7 text-warm-700">{card}</p>
        </article>
      ))}
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] gap-6 mt-6">
      <article class="bg-white rounded-2xl border border-warm-200 p-6">
        <h2 class="text-xl font-semibold text-ocean-900">{t(lang, 'reservations.pilotInventoryTitle')}</h2>
        <p class="mt-3 text-sm leading-7 text-warm-700">
          {t(lang, 'reservations.pilotInventorySummary')}
        </p>
        <p class="mt-3 text-sm leading-7 text-warm-700">
          {t(lang, 'reservations.pilotInventoryNote')}
        </p>
      </article>

      <article class="bg-sand-50 rounded-2xl border border-sand-200 p-6">
        <h2 class="text-xl font-semibold text-ocean-900">{t(lang, 'reservations.pilotFutureTitle')}</h2>
        <p class="mt-3 text-sm leading-7 text-warm-700">
          {t(lang, 'reservations.pilotFutureBody')}
        </p>
      </article>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6">
      {detailCards.map((card) => (
        <article class="rounded-2xl border border-ocean-100 bg-ocean-50 px-5 py-5">
          <p class="text-sm leading-7 text-warm-700">{card}</p>
        </article>
      ))}
    </div>
  </section>
</Page>
