---
export const prerender = false;

import Page from '@/layouts/Page.astro';
import type { Language } from '@/lib/i18n';
import { LANGUAGES } from '@/lib/i18n';
import { getTranslations, t } from '@/lib/translations';

const lang = Astro.params.lang as Language;
const postId = Astro.params.id;
if (!LANGUAGES.includes(lang)) return Astro.redirect('/en/community/');

const translations = getTranslations(lang);
const user = Astro.locals.user;
if (!user) return Astro.redirect(`/${lang}/community/login/`);
---

<Page
  title={t(lang, 'postForm.editTitle')}
  description={t(lang, 'community.subtitle')}
  lang={lang}
  translations={translations}
  noIndex={true}
>
  <section class="container-page py-10 max-w-2xl mx-auto">
    <a href={`/${lang}/community/${postId}/`} class="inline-flex items-center gap-1 text-sm text-ocean-600 hover:text-ocean-800 mb-6 transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      {t(lang, 'community.backToCommunity')}
    </a>

    <div class="bg-white rounded-2xl border border-warm-200 p-6 md:p-8">
      <h1 class="text-2xl font-display text-ocean-900 mb-6">{t(lang, 'postForm.editTitle')}</h1>

      <div id="edit-form-container">
        <div class="text-center py-8 text-warm-400">{t(lang, 'common.loading')}</div>
      </div>
    </div>
  </section>
</Page>

<script define:vars={{ lang, postId }}>
  const HTML_ESCAPE_MAP = {
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;',
  };

  function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, (char) => HTML_ESCAPE_MAP[char]);
  }

  async function loadEditForm() {
    const container = document.getElementById('edit-form-container');
    if (!container) return;

    try {
      const res = await fetch(`/api/posts/${postId}/`);
      if (!res.ok) {
        container.innerHTML = '<div class="text-center py-8 text-coral-500">Post not found</div>';
        return;
      }

      const { post } = await res.json();
      const safeTitle = escapeHtml(post.title);
      const safeBody = escapeHtml(post.body);
      const safeLocation = escapeHtml(post.location || '');
      const safeEventDate = escapeHtml(post.event_date || '');
      const safeEventTime = escapeHtml(post.event_time || '');
      const safeMaxParticipants = escapeHtml(post.max_participants || '');

      container.innerHTML = `
        <form id="edit-form" class="space-y-5">
          <div>
            <label class="block text-sm font-medium text-warm-700 mb-1.5">Category</label>
            <select name="category" class="w-full px-4 py-2.5 border border-warm-300 rounded-lg focus:ring-2 focus:ring-ocean-500 focus:border-ocean-500">
              <option value="sports" ${post.category === 'sports' ? 'selected' : ''}>Sports</option>
              <option value="social" ${post.category === 'social' ? 'selected' : ''}>Social</option>
              <option value="culture" ${post.category === 'culture' ? 'selected' : ''}>Culture</option>
              <option value="food-drink" ${post.category === 'food-drink' ? 'selected' : ''}>Food & Drink</option>
              <option value="other" ${post.category === 'other' ? 'selected' : ''}>Other</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-warm-700 mb-1.5">Title</label>
            <input type="text" name="title" required minlength="3" maxlength="200" value="${safeTitle}" class="w-full px-4 py-2.5 border border-warm-300 rounded-lg focus:ring-2 focus:ring-ocean-500 focus:border-ocean-500" />
          </div>
          <div>
            <label class="block text-sm font-medium text-warm-700 mb-1.5">Description</label>
            <textarea name="body" required rows="5" minlength="10" maxlength="5000" class="w-full px-4 py-2.5 border border-warm-300 rounded-lg focus:ring-2 focus:ring-ocean-500 focus:border-ocean-500 resize-y">${safeBody}</textarea>
          </div>
          <div>
            <label class="block text-sm font-medium text-warm-700 mb-1.5">Location</label>
            <input type="text" name="location" value="${safeLocation}" class="w-full px-4 py-2.5 border border-warm-300 rounded-lg focus:ring-2 focus:ring-ocean-500 focus:border-ocean-500" />
          </div>
          ${post.type === 'meetup' || post.type === 'event-idea' ? `
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-warm-700 mb-1.5">Date</label>
              <input type="date" name="event_date" value="${safeEventDate}" class="w-full px-4 py-2.5 border border-warm-300 rounded-lg focus:ring-2 focus:ring-ocean-500 focus:border-ocean-500" />
            </div>
            <div>
              <label class="block text-sm font-medium text-warm-700 mb-1.5">Time</label>
              <input type="time" name="event_time" value="${safeEventTime}" class="w-full px-4 py-2.5 border border-warm-300 rounded-lg focus:ring-2 focus:ring-ocean-500 focus:border-ocean-500" />
            </div>
          </div>` : ''}
          ${post.type === 'meetup' ? `
          <div>
            <label class="block text-sm font-medium text-warm-700 mb-1.5">Max Participants</label>
            <input type="number" name="max_participants" min="2" max="100" value="${safeMaxParticipants}" class="w-full px-4 py-2.5 border border-warm-300 rounded-lg focus:ring-2 focus:ring-ocean-500 focus:border-ocean-500" />
          </div>` : ''}
          <div class="bg-sand-50 border border-sand-200 text-sand-800 px-4 py-3 rounded-lg text-sm">
            Editing will reset the post to pending review.
          </div>
          <button type="submit" id="update-btn" class="w-full bg-ocean-600 hover:bg-ocean-700 text-white font-semibold py-3 px-4 rounded-lg transition-colors duration-200 disabled:opacity-50">
            Update Post
          </button>
        </form>
      `;

      document.getElementById('edit-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = document.getElementById('update-btn');
        btn.disabled = true;
        const form = e.target;

        try {
          const res = await fetch(`/api/posts/${postId}/`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              title: form.title.value,
              body: form.body.value,
              category: form.category.value,
              location: form.location?.value || undefined,
              event_date: form.event_date?.value || undefined,
              event_time: form.event_time?.value || undefined,
              max_participants: form.max_participants?.value ? parseInt(form.max_participants.value) : undefined,
            }),
          });

          if (res.ok) {
            window.location.href = `/${lang}/community/${postId}/`;
          } else {
            const err = await res.json();
            alert(err.error || 'Failed to update');
            btn.disabled = false;
          }
        } catch {
          alert('Network error');
          btn.disabled = false;
        }
      });
    } catch {
      container.innerHTML = '<div class="text-center py-8 text-coral-500">Failed to load post</div>';
    }
  }

  loadEditForm();
</script>
