---
export const prerender = false;

import Page from '@/layouts/Page.astro';
import Button from '@/components/ui/Button.astro';
import type { Language } from '@/lib/i18n';
import { LANGUAGES } from '@/lib/i18n';
import { getFounderSprintOgImagePath } from '@/lib/founder-social-card';
import { getTranslations, t } from '@/lib/translations';

const lang = Astro.params.lang as Language;
if (!LANGUAGES.includes(lang)) return Astro.redirect('/en/community/start/');

const translations = getTranslations(lang);
const user = Astro.locals.user;
const alternates = Object.fromEntries(
  LANGUAGES.map((locale) => [locale, `/${locale}/community/start/`]),
) as Record<Language, string>;

const actionCards = [
  {
    title: t(lang, 'reservations.viewSportsReservations'),
    body: t(lang, 'community.startActionScheduleBody'),
    href: `/${lang}/community/reservations/`,
    cta: t(lang, 'reservations.viewSportsReservations'),
    tone: 'from-ocean-500/10 via-ocean-100 to-white',
  },
  {
    title: t(lang, 'community.filterMeetup'),
    body: t(lang, 'community.startActionMeetupsBody'),
    href: `/${lang}/community/?type=meetup`,
    cta: t(lang, 'community.filterMeetup'),
    tone: 'from-sand-300/20 via-sand-100 to-white',
  },
  {
    title: t(lang, 'reservations.contactCta'),
    body: t(lang, 'community.startActionFeedbackBody'),
    href: `/${lang}/contact/`,
    cta: t(lang, 'reservations.contactCta'),
    tone: 'from-coral-300/15 via-coral-50 to-white',
  },
];

const whoItsFor = [
  t(lang, 'community.startWhoPoint1'),
  t(lang, 'community.startWhoPoint2'),
  t(lang, 'community.startWhoPoint3'),
];

const firstWaveSteps = [
  t(lang, 'community.startFlowPoint1'),
  t(lang, 'community.startFlowPoint2'),
  t(lang, 'community.startFlowPoint3'),
];

const primaryCtaHref = user ? `/${lang}/community/create/?type=meetup&category=sports` : `/${lang}/community/login/`;
const primaryCtaLabel = user ? t(lang, 'community.createPost') : t(lang, 'auth.signIn');
---

<Page
  title={t(lang, 'community.startTitle')}
  description={t(lang, 'community.startDescription')}
  lang={lang}
  translations={translations}
  alternates={alternates}
  ogImage={getFounderSprintOgImagePath(lang, 'start')}
  ogImageAlt={t(lang, 'community.startTitle')}
  noIndex={true}
>
  <section class="relative overflow-hidden border-b border-warm-200 bg-[linear-gradient(135deg,#f4fbff_0%,#ffffff_42%,#fff5ea_100%)]">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute -top-24 right-[-6rem] h-72 w-72 rounded-full bg-ocean-200/40 blur-3xl"></div>
      <div class="absolute bottom-[-5rem] left-[-3rem] h-56 w-56 rounded-full bg-sand-200/40 blur-3xl"></div>
    </div>

    <div class="container-page relative py-16 md:py-24">
      <div class="max-w-4xl">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-ocean-600">
          {t(lang, 'community.startEyebrow')}
        </p>
        <h1 class="mt-4 max-w-3xl text-4xl md:text-6xl font-display leading-tight text-ocean-950">
          {t(lang, 'community.startTitle')}
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-warm-700">
          {t(lang, 'community.startDescription')}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={primaryCtaHref} variant="primary" size="lg">
            {primaryCtaLabel}
          </Button>
          <Button href={`/${lang}/community/help/`} variant="secondary" size="lg">
            {t(lang, 'community.helpCta')}
          </Button>
          <Button href={`/${lang}/community/reservations/`} variant="outline" size="lg">
            {t(lang, 'reservations.viewSportsReservations')}
          </Button>
          <Button href={`/${lang}/community/?type=meetup`} variant="secondary" size="lg">
            {t(lang, 'community.filterMeetup')}
          </Button>
        </div>
      </div>
    </div>
  </section>

  <section class="container-page py-12 md:py-16">
    <div class="grid grid-cols-1 gap-8 xl:grid-cols-[minmax(0,0.44fr)_minmax(0,0.56fr)]">
      <div class="max-w-xl">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-ocean-600">
          {t(lang, 'community.startActionsTitle')}
        </p>
        <h2 class="mt-3 text-3xl font-display text-ocean-900">
          {t(lang, 'community.startActionsDescription')}
        </h2>
      </div>

      <div class="overflow-hidden rounded-[1.75rem] border border-warm-200 bg-white">
        {actionCards.map((card, index) => (
          <article class:list={[
            'bg-gradient-to-br px-6 py-6 md:px-7 md:py-7',
            card.tone,
            { 'border-t border-warm-200': index > 0 },
          ]}>
            <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
              <div class="max-w-2xl">
                <h3 class="text-xl font-semibold text-ocean-900">{card.title}</h3>
                <p class="mt-2 text-sm leading-7 text-warm-700">{card.body}</p>
              </div>
              <a
                href={card.href}
                class="inline-flex shrink-0 items-center gap-2 text-sm font-semibold text-ocean-700 hover:text-ocean-900"
              >
                {card.cta}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="container-page pb-12 md:pb-16">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <article class="overflow-hidden rounded-[1.75rem] border border-warm-200 bg-white">
        <div class="border-b border-warm-100 bg-warm-50 px-6 py-5">
          <p class="text-sm font-semibold uppercase tracking-[0.14em] text-warm-600">
            {t(lang, 'community.startWhoTitle')}
          </p>
          <p class="mt-3 max-w-xl text-base leading-7 text-warm-700">
            {t(lang, 'community.startWhoDescription')}
          </p>
        </div>
        <div class="px-6 py-6">
          <ul class="space-y-4">
            {whoItsFor.map((point) => (
              <li class="flex items-start gap-3">
                <span class="mt-1 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-ocean-600 text-xs font-semibold text-white">
                  ✓
                </span>
                <span class="text-sm leading-7 text-warm-700">{point}</span>
              </li>
            ))}
          </ul>
        </div>
      </article>

      <article class="overflow-hidden rounded-[1.75rem] border border-ocean-200 bg-[linear-gradient(180deg,#fbfeff_0%,#eef8fd_100%)]">
        <div class="border-b border-ocean-100 px-6 py-5">
          <p class="text-sm font-semibold uppercase tracking-[0.14em] text-ocean-600">
            {t(lang, 'community.startFlowTitle')}
          </p>
          <p class="mt-3 max-w-xl text-base leading-7 text-warm-700">
            {t(lang, 'community.startFlowDescription')}
          </p>
        </div>
        <div class="px-6 py-6">
          <div class="space-y-5">
            {firstWaveSteps.map((point, index) => (
              <div class="flex gap-4">
                <div class="flex flex-col items-center">
                  <span class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-ocean-200 bg-white text-sm font-semibold text-ocean-700">
                    {index + 1}
                  </span>
                  {index < firstWaveSteps.length - 1 && <span class="mt-2 h-full w-px bg-ocean-200"></span>}
                </div>
                <p class="pb-4 pt-1 text-sm leading-7 text-warm-700">{point}</p>
              </div>
            ))}
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="container-page pb-16">
    <div class="rounded-[2rem] border border-coral-200 bg-[linear-gradient(135deg,#fff7f2_0%,#ffffff_50%,#f4fbff_100%)] px-6 py-8 md:px-10 md:py-10">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-coral-500">
          {t(lang, 'community.startFinalTitle')}
        </p>
        <p class="mt-4 text-lg leading-8 text-warm-700">
          {t(lang, 'community.startFinalDescription')}
        </p>
      </div>

      <div class="mt-7 flex flex-wrap gap-3">
        <Button href={`/${lang}/community/reservations/dashboard/`} variant="primary">
          {t(lang, 'reservations.viewTransparencyDashboard')}
        </Button>
        <Button href={`/${lang}/community/help/`} variant="outline">
          {t(lang, 'community.helpCta')}
        </Button>
        <Button href={`/${lang}/community/pilot/`} variant="outline">
          {t(lang, 'community.pilotUpdateCta')}
        </Button>
        <Button href={`/${lang}/play/`} variant="outline">
          {t(lang, 'reservations.quickStartTitle')}
        </Button>
        <Button href={`/${lang}/contact/`} variant="secondary">
          {t(lang, 'reservations.contactCta')}
        </Button>
      </div>
    </div>
  </section>
</Page>
