---
export const prerender = false;

import { getEntry } from 'astro:content';
import Page from '@/layouts/Page.astro';
import Button from '@/components/ui/Button.astro';
import { getFounderSprintOgImagePath } from '@/lib/founder-social-card';
import type { Language } from '@/lib/i18n';
import { LANGUAGES } from '@/lib/i18n';
import { getTranslations, t } from '@/lib/translations';

const lang = Astro.params.lang as Language;
if (!LANGUAGES.includes(lang)) return Astro.redirect('/en/community/admin/comms/');

const translations = getTranslations(lang);
const user = Astro.locals.user;

if (!user || user.role !== 'admin') {
  return Astro.redirect(`/${lang}/community/`);
}

const alternates = Object.fromEntries(
  LANGUAGES.map((locale) => [locale, `/${locale}/community/admin/comms/`]),
) as Record<Language, string>;

const siteConfig = await getEntry('global', 'site-config');
const siteUrl = siteConfig?.data.siteUrl ?? 'https://znjan.com';

const pilotUrl = `${siteUrl}/${lang}/community/pilot/`;
const startUrl = `${siteUrl}/${lang}/community/start/`;
const helpUrl = `${siteUrl}/${lang}/community/help/`;
const playUrl = `${siteUrl}/${lang}/play/`;
const dashboardUrl = `${siteUrl}/${lang}/community/sports/dashboard/`;

const publishingCadence = [
  {
    label: t(lang, 'admin.commsCadenceStep1Label'),
    title: t(lang, 'admin.commsCadenceStep1Title'),
    body: t(lang, 'admin.commsCadenceStep1Body'),
    href: pilotUrl,
  },
  {
    label: t(lang, 'admin.commsCadenceStep2Label'),
    title: t(lang, 'admin.commsCadenceStep2Title'),
    body: t(lang, 'admin.commsCadenceStep2Body'),
    href: startUrl,
  },
  {
    label: t(lang, 'admin.commsCadenceStep3Label'),
    title: t(lang, 'admin.commsCadenceStep3Title'),
    body: t(lang, 'admin.commsCadenceStep3Body'),
    href: playUrl,
  },
  {
    label: t(lang, 'admin.commsCadenceStep4Label'),
    title: t(lang, 'admin.commsCadenceStep4Title'),
    body: t(lang, 'admin.commsCadenceStep4Body'),
    href: dashboardUrl,
  },
];

const postScripts = [
  {
    title: t(lang, 'admin.commsPostLiveTitle'),
    body: t(lang, 'admin.commsPostLiveBody'),
    href: pilotUrl,
    hrefLabel: t(lang, 'admin.commsLinkPilot'),
  },
  {
    title: t(lang, 'admin.commsPostStartTitle'),
    body: t(lang, 'admin.commsPostStartBody'),
    href: startUrl,
    hrefLabel: t(lang, 'admin.commsLinkStart'),
  },
  {
    title: t(lang, 'admin.commsPostPlayTitle'),
    body: t(lang, 'admin.commsPostPlayBody'),
    href: playUrl,
    hrefLabel: t(lang, 'admin.commsLinkPlay'),
  },
];

const guardrails = [
  t(lang, 'admin.commsGuardrail1'),
  t(lang, 'admin.commsGuardrail2'),
  t(lang, 'admin.commsGuardrail3'),
  t(lang, 'admin.commsGuardrail4'),
];

const quickActions = [
  { href: `/${lang}/community/admin/venues/`, label: t(lang, 'admin.manageCommercialValidation') },
  { href: `/${lang}/community/pilot/`, label: t(lang, 'community.pilotUpdateCta') },
  { href: `/${lang}/community/start/`, label: t(lang, 'community.startCta') },
  { href: `/${lang}/community/help/`, label: t(lang, 'community.helpCta') },
  { href: `/${lang}/play/`, label: t(lang, 'reservations.quickStartTitle') },
  { href: `/${lang}/play/materials/`, label: t(lang, 'reservations.pilotKitCta') },
];

const shareAssets = [
  {
    title: t(lang, 'admin.commsAssetPilotTitle'),
    pageUrl: pilotUrl,
    cardUrl: `${siteUrl}${getFounderSprintOgImagePath(lang, 'pilot')}`,
  },
  {
    title: t(lang, 'admin.commsAssetStartTitle'),
    pageUrl: startUrl,
    cardUrl: `${siteUrl}${getFounderSprintOgImagePath(lang, 'start')}`,
  },
  {
    title: t(lang, 'community.helpCta'),
    pageUrl: helpUrl,
    cardUrl: `${siteUrl}${getFounderSprintOgImagePath(lang, 'help')}`,
  },
  {
    title: t(lang, 'admin.commsAssetPlayTitle'),
    pageUrl: playUrl,
    cardUrl: `${siteUrl}${getFounderSprintOgImagePath(lang, 'play')}`,
  },
];
---

<Page
  title={t(lang, 'admin.commsTitle')}
  description={t(lang, 'admin.commsDescription')}
  lang={lang}
  translations={translations}
  alternates={alternates}
  noIndex={true}
>
  <section class="container-page py-10 space-y-8">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-ocean-600 mb-3">
          {t(lang, 'admin.title')}
        </p>
        <h1 class="text-3xl md:text-4xl font-display text-ocean-900 mb-3">
          {t(lang, 'admin.commsTitle')}
        </h1>
        <p class="text-lg text-warm-600">
          {t(lang, 'admin.commsDescription')}
        </p>
      </div>

      <div class="flex flex-wrap gap-3">
        <a
          href={`/${lang}/community/admin/`}
          class="inline-flex items-center justify-center rounded-lg border border-warm-200 bg-white px-4 py-2.5 text-sm font-semibold text-ocean-700 hover:border-ocean-300 transition-colors"
        >
          {t(lang, 'admin.title')}
        </a>
        <a
          href={`/${lang}/community/admin/pilot/`}
          class="inline-flex items-center justify-center rounded-lg border border-warm-200 bg-white px-4 py-2.5 text-sm font-semibold text-ocean-700 hover:border-ocean-300 transition-colors"
        >
          {t(lang, 'admin.managePilotOps')}
        </a>
        <a
          href={`/${lang}/community/pilot/`}
          class="inline-flex items-center justify-center rounded-full bg-ocean-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-ocean-700 transition-colors"
        >
          {t(lang, 'community.pilotUpdateCta')}
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 xl:grid-cols-[minmax(0,1fr)_22rem]">
      <div class="space-y-6">
        <article class="rounded-2xl border border-warm-200 bg-white p-6">
          <h2 class="text-xl font-semibold text-ocean-900">{t(lang, 'admin.commsOneLineTitle')}</h2>
          <p class="mt-2 text-sm text-warm-600">{t(lang, 'admin.commsOneLineDescription')}</p>
          <div class="mt-5 rounded-2xl border border-ocean-100 bg-ocean-50 px-5 py-5">
            <p class="text-base leading-7 text-ocean-900">{t(lang, 'admin.commsOneLineBody')}</p>
          </div>
        </article>

        <article class="rounded-2xl border border-warm-200 bg-white p-6">
          <h2 class="text-xl font-semibold text-ocean-900">{t(lang, 'admin.commsBioTitle')}</h2>
          <p class="mt-2 text-sm text-warm-600">{t(lang, 'admin.commsBioDescription')}</p>

          <div class="mt-5 grid grid-cols-1 gap-4 md:grid-cols-2">
            <div class="rounded-2xl border border-warm-100 bg-warm-50 px-5 py-5">
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-warm-500">{t(lang, 'admin.commsBioShortLabel')}</p>
              <p class="mt-3 text-sm leading-7 text-warm-800">{t(lang, 'admin.commsBioShortText')}</p>
            </div>
            <div class="rounded-2xl border border-warm-100 bg-warm-50 px-5 py-5">
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-warm-500">{t(lang, 'admin.commsBioLongLabel')}</p>
              <p class="mt-3 text-sm leading-7 text-warm-800">{t(lang, 'admin.commsBioLongText')}</p>
            </div>
          </div>
        </article>

        <article class="rounded-2xl border border-warm-200 bg-white p-6">
          <h2 class="text-xl font-semibold text-ocean-900">{t(lang, 'admin.commsDirectTitle')}</h2>
          <p class="mt-2 text-sm text-warm-600">{t(lang, 'admin.commsDirectDescription')}</p>

          <div class="mt-5 grid grid-cols-1 gap-4 md:grid-cols-2">
            <div class="rounded-2xl border border-sand-200 bg-sand-50 px-5 py-5">
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-sand-700">{t(lang, 'admin.commsDirectVenueLabel')}</p>
              <p class="mt-3 text-sm leading-7 text-warm-800">{t(lang, 'admin.commsDirectVenueText')}</p>
            </div>
            <div class="rounded-2xl border border-coral-200 bg-coral-50 px-5 py-5">
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-coral-600">{t(lang, 'admin.commsDirectSupporterLabel')}</p>
              <p class="mt-3 text-sm leading-7 text-warm-800">{t(lang, 'admin.commsDirectSupporterText')}</p>
            </div>
          </div>
        </article>

        <article class="rounded-2xl border border-warm-200 bg-white p-6">
          <h2 class="text-xl font-semibold text-ocean-900">{t(lang, 'admin.commsPostsTitle')}</h2>
          <p class="mt-2 text-sm text-warm-600">{t(lang, 'admin.commsPostsDescription')}</p>

          <div class="mt-6 space-y-4">
            {postScripts.map((post) => (
              <div class="rounded-2xl border border-warm-100 bg-warm-50 px-5 py-5">
                <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
                  <div class="max-w-3xl">
                    <h3 class="text-lg font-semibold text-ocean-900">{post.title}</h3>
                    <p class="mt-3 text-sm leading-7 text-warm-800">{post.body}</p>
                  </div>
                  <div class="rounded-xl border border-ocean-100 bg-white px-4 py-3 text-sm text-ocean-800 md:min-w-[15rem]">
                    <div class="text-xs uppercase tracking-[0.14em] text-ocean-600">{post.hrefLabel}</div>
                    <div class="mt-2 break-all">{post.href}</div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </article>

        <article class="rounded-2xl border border-warm-200 bg-white p-6">
          <h2 class="text-xl font-semibold text-ocean-900">{t(lang, 'admin.commsCadenceTitle')}</h2>
          <p class="mt-2 text-sm text-warm-600">{t(lang, 'admin.commsCadenceDescription')}</p>

          <div class="mt-6 space-y-4">
            {publishingCadence.map((item) => (
              <div class="rounded-2xl border border-ocean-100 bg-ocean-50/60 px-5 py-5">
                <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                  <div class="max-w-3xl">
                    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ocean-600">{item.label}</p>
                    <h3 class="mt-2 text-lg font-semibold text-ocean-900">{item.title}</h3>
                    <p class="mt-3 text-sm leading-7 text-warm-800">{item.body}</p>
                  </div>
                  <div class="rounded-xl border border-ocean-100 bg-white px-4 py-3 text-sm text-ocean-800 md:min-w-[15rem]">
                    <div class="text-xs uppercase tracking-[0.14em] text-ocean-600">{t(lang, 'admin.commsAssetPublicLabel')}</div>
                    <div class="mt-2 break-all">{item.href}</div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </article>
      </div>

      <div class="space-y-6">
        <article class="rounded-2xl border border-warm-200 bg-white p-6">
          <h2 class="text-xl font-semibold text-ocean-900">{t(lang, 'admin.quickActionsTitle')}</h2>
          <p class="mt-2 text-sm text-warm-600">{t(lang, 'admin.quickActionsDescription')}</p>

          <div class="mt-5 flex flex-col gap-3">
            {quickActions.map((action) => (
              <Button href={action.href} variant="outline" class="w-full">
                {action.label}
              </Button>
            ))}
          </div>
        </article>

        <article class="rounded-2xl border border-warm-200 bg-white p-6">
          <h2 class="text-xl font-semibold text-ocean-900">{t(lang, 'admin.commsAssetsTitle')}</h2>
          <p class="mt-2 text-sm text-warm-600">{t(lang, 'admin.commsAssetsDescription')}</p>

          <div class="mt-5 space-y-4">
            {shareAssets.map((asset) => (
              <div class="rounded-2xl border border-warm-100 bg-warm-50 px-4 py-4">
                <h3 class="text-base font-semibold text-ocean-900">{asset.title}</h3>
                <div class="mt-4 space-y-3 text-sm text-warm-800">
                  <div>
                    <div class="text-xs font-semibold uppercase tracking-[0.14em] text-warm-500">{t(lang, 'admin.commsAssetPublicLabel')}</div>
                    <div class="mt-1 break-all">{asset.pageUrl}</div>
                  </div>
                  <div>
                    <div class="text-xs font-semibold uppercase tracking-[0.14em] text-warm-500">{t(lang, 'admin.commsAssetCardLabel')}</div>
                    <div class="mt-1 break-all">{asset.cardUrl}</div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </article>

        <article class="rounded-2xl border border-warm-200 bg-white p-6">
          <h2 class="text-xl font-semibold text-ocean-900">{t(lang, 'admin.commsGuardrailsTitle')}</h2>
          <p class="mt-2 text-sm text-warm-600">{t(lang, 'admin.commsGuardrailsDescription')}</p>

          <ul class="mt-5 space-y-3">
            {guardrails.map((point) => (
              <li class="flex items-start gap-3 rounded-xl border border-warm-100 bg-warm-50 px-4 py-3">
                <span class="mt-1 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-ocean-600 text-xs font-semibold text-white">
                  ✓
                </span>
                <span class="text-sm leading-7 text-warm-700">{point}</span>
              </li>
            ))}
          </ul>
        </article>
      </div>
    </div>
  </section>
</Page>
