---
export const prerender = false;

import Page from '@/layouts/Page.astro';
import type { Language } from '@/lib/i18n';
import { LANGUAGES } from '@/lib/i18n';
import { getTranslations, t } from '@/lib/translations';

const lang = Astro.params.lang as Language;
if (!LANGUAGES.includes(lang)) return Astro.redirect('/en/community/');

const translations = getTranslations(lang);
const user = Astro.locals.user;
if (!user) return Astro.redirect(`/${lang}/community/login/`);
---

<Page
  title={t(lang, 'postForm.createTitle')}
  description={t(lang, 'community.subtitle')}
  lang={lang}
  translations={translations}
  noIndex={true}
>
  <section class="container-page py-10 max-w-2xl mx-auto">
    <a href={`/${lang}/community/`} class="inline-flex items-center gap-1 text-sm text-ocean-600 hover:text-ocean-800 mb-6 transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      {t(lang, 'community.backToCommunity')}
    </a>

    <div class="bg-white rounded-2xl border border-warm-200 p-6 md:p-8">
      <h1 class="text-2xl font-display text-ocean-900 mb-6">{t(lang, 'postForm.createTitle')}</h1>

      <form id="post-form" class="space-y-5">
        <!-- Type -->
        <div>
          <label class="block text-sm font-medium text-warm-700 mb-1.5">{t(lang, 'postForm.typeLabel')}</label>
          <div class="grid grid-cols-2 gap-2">
            {[
              { value: 'meetup', label: t(lang, 'postForm.typeMeetup') },
              { value: 'event-idea', label: t(lang, 'postForm.typeEventIdea') },
              { value: 'partner-search', label: t(lang, 'postForm.typePartnerSearch') },
              { value: 'discussion', label: t(lang, 'postForm.typeDiscussion') },
            ].map((opt) => (
              <label class="flex items-center gap-2 p-3 rounded-lg border border-warm-200 hover:border-ocean-300 cursor-pointer has-[:checked]:border-ocean-500 has-[:checked]:bg-ocean-50 transition-colors">
                <input type="radio" name="type" value={opt.value} class="text-ocean-600" required />
                <span class="text-sm">{opt.label}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Category -->
        <div>
          <label class="block text-sm font-medium text-warm-700 mb-1.5">{t(lang, 'postForm.categoryLabel')}</label>
          <select name="category" required class="w-full px-4 py-2.5 border border-warm-300 rounded-lg focus:ring-2 focus:ring-ocean-500 focus:border-ocean-500">
            <option value="sports">{t(lang, 'community.categorySports')}</option>
            <option value="social">{t(lang, 'community.categorySocial')}</option>
            <option value="culture">{t(lang, 'community.categoryCulture')}</option>
            <option value="food-drink">{t(lang, 'community.categoryFoodDrink')}</option>
            <option value="other">{t(lang, 'community.categoryOther')}</option>
          </select>
        </div>

        <!-- Title -->
        <div>
          <label for="title" class="block text-sm font-medium text-warm-700 mb-1.5">{t(lang, 'postForm.titleLabel')}</label>
          <input
            type="text" id="title" name="title" required
            minlength="3" maxlength="200"
            placeholder={t(lang, 'postForm.titlePlaceholder')}
            class="w-full px-4 py-2.5 border border-warm-300 rounded-lg focus:ring-2 focus:ring-ocean-500 focus:border-ocean-500"
          />
        </div>

        <!-- Body -->
        <div>
          <label for="body" class="block text-sm font-medium text-warm-700 mb-1.5">{t(lang, 'postForm.bodyLabel')}</label>
          <textarea
            id="body" name="body" required rows="5"
            minlength="10" maxlength="5000"
            placeholder={t(lang, 'postForm.bodyPlaceholder')}
            class="w-full px-4 py-2.5 border border-warm-300 rounded-lg focus:ring-2 focus:ring-ocean-500 focus:border-ocean-500 resize-y"
          ></textarea>
        </div>

        <!-- Location -->
        <div>
          <label for="location" class="block text-sm font-medium text-warm-700 mb-1.5">{t(lang, 'postForm.locationLabel')}</label>
          <input
            type="text" id="location" name="location"
            placeholder={t(lang, 'postForm.locationPlaceholder')}
            class="w-full px-4 py-2.5 border border-warm-300 rounded-lg focus:ring-2 focus:ring-ocean-500 focus:border-ocean-500"
          />
        </div>

        <!-- Date/Time (for meetups/events) -->
        <div id="date-time-fields" class="grid grid-cols-2 gap-4 hidden">
          <div>
            <label for="event_date" class="block text-sm font-medium text-warm-700 mb-1.5">{t(lang, 'postForm.dateLabel')}</label>
            <input
              type="date" id="event_date" name="event_date"
              class="w-full px-4 py-2.5 border border-warm-300 rounded-lg focus:ring-2 focus:ring-ocean-500 focus:border-ocean-500"
            />
          </div>
          <div>
            <label for="event_time" class="block text-sm font-medium text-warm-700 mb-1.5">{t(lang, 'postForm.timeLabel')}</label>
            <input
              type="time" id="event_time" name="event_time"
              class="w-full px-4 py-2.5 border border-warm-300 rounded-lg focus:ring-2 focus:ring-ocean-500 focus:border-ocean-500"
            />
          </div>
        </div>

        <!-- Max participants (for meetups) -->
        <div id="max-participants-field" class="hidden">
          <label for="max_participants" class="block text-sm font-medium text-warm-700 mb-1.5">{t(lang, 'postForm.maxParticipantsLabel')}</label>
          <input
            type="number" id="max_participants" name="max_participants"
            min="2" max="100"
            class="w-full px-4 py-2.5 border border-warm-300 rounded-lg focus:ring-2 focus:ring-ocean-500 focus:border-ocean-500"
          />
        </div>

        <!-- Pending note -->
        <div class="bg-sand-50 border border-sand-200 text-sand-800 px-4 py-3 rounded-lg text-sm">
          {t(lang, 'postForm.pendingNote')}
        </div>

        <button
          type="submit"
          id="submit-btn"
          class="w-full bg-ocean-600 hover:bg-ocean-700 text-white font-semibold py-3 px-4 rounded-lg transition-colors duration-200 disabled:opacity-50"
        >
          {t(lang, 'postForm.submit')}
        </button>
      </form>
    </div>
  </section>
</Page>

<script define:vars={{ lang }}>
  // Show/hide date/time/participant fields based on type
  document.querySelectorAll('input[name="type"]').forEach((radio) => {
    radio.addEventListener('change', (e) => {
      const type = e.target.value;
      const dtFields = document.getElementById('date-time-fields');
      const mpField = document.getElementById('max-participants-field');
      if (type === 'meetup' || type === 'event-idea') {
        dtFields.classList.remove('hidden');
      } else {
        dtFields.classList.add('hidden');
      }
      if (type === 'meetup') {
        mpField.classList.remove('hidden');
      } else {
        mpField.classList.add('hidden');
      }
    });
  });

  document.getElementById('post-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('submit-btn');
    btn.disabled = true;

    const form = e.target;
    const data = {
      title: form.title.value,
      body: form.body.value,
      type: form.type.value,
      category: form.category.value,
      location: form.location.value || undefined,
      event_date: form.event_date?.value || undefined,
      event_time: form.event_time?.value || undefined,
      max_participants: form.max_participants?.value ? parseInt(form.max_participants.value) : undefined,
      lang,
    };

    try {
      const res = await fetch('/api/posts/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        window.location.href = `/${lang}/community/`;
      } else {
        const err = await res.json();
        alert(err.error || 'Failed to create post');
        btn.disabled = false;
      }
    } catch {
      alert('Network error');
      btn.disabled = false;
    }
  });
</script>
