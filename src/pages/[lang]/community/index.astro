---
export const prerender = false;

import Page from '@/layouts/Page.astro';
import type { Language } from '@/lib/i18n';
import { LANGUAGES, ROUTE_SEGMENTS } from '@/lib/i18n';
import { getTranslations, t } from '@/lib/translations';
import AuthBanner from '@/components/community/AuthBanner.astro';
import PostFilters from '@/components/community/PostFilters.astro';
import Leaderboard from '@/components/community/Leaderboard.astro';

const lang = Astro.params.lang as Language;
if (!LANGUAGES.includes(lang)) return Astro.redirect('/en/community/');

const translations = getTranslations(lang);
const user = Astro.locals.user;
const activeType = Astro.url.searchParams.get('type') || '';
const activeCategory = Astro.url.searchParams.get('category') || '';
const contactUrl = `/${lang}/${ROUTE_SEGMENTS.contact[lang]}/`;
const feedLabels = {
  loading: t(lang, 'common.loading'),
  empty: t(lang, 'community.noPostsYet'),
  errorTitle: t(lang, 'community.feedErrorTitle'),
  errorDescription: t(lang, 'community.feedErrorDescription'),
  retry: t(lang, 'community.feedErrorRetry'),
  contact: t(lang, 'community.feedErrorContact'),
};
---

<Page
  title={t(lang, 'community.title')}
  description={t(lang, 'community.subtitle')}
  lang={lang}
  translations={translations}
  noIndex={true}
>
  <section class="container-page py-10">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl md:text-4xl font-display text-ocean-900 mb-2">
        {t(lang, 'community.title')}
      </h1>
      <p class="text-warm-600 text-lg">{t(lang, 'community.subtitle')}</p>
    </div>

    <!-- Auth Banner -->
    <div class="mb-6">
      <AuthBanner lang={lang} user={user} />
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <!-- Main content -->
      <div class="lg:col-span-3 space-y-6">
        <!-- Filters + Create button -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <PostFilters lang={lang} activeType={activeType} activeCategory={activeCategory} />
          <div class="flex flex-wrap items-center gap-3">
            <a
              href={`/${lang}/community/start/`}
              class="inline-flex items-center gap-2 bg-sand-50 border border-sand-200 hover:border-coral-300 text-warm-700 font-semibold px-5 py-2.5 rounded-lg transition-colors shrink-0"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
              {t(lang, 'community.startCta')}
            </a>
            <a
              href={`/${lang}/community/help/`}
              class="inline-flex items-center gap-2 bg-white border border-coral-200 hover:border-coral-400 text-coral-700 font-semibold px-5 py-2.5 rounded-lg transition-colors shrink-0"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.868v4.264a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {t(lang, 'community.helpCta')}
            </a>
            <a
              href={`/${lang}/community/sports/`}
              class="inline-flex items-center gap-2 bg-white border border-ocean-200 hover:border-ocean-400 text-ocean-700 font-semibold px-5 py-2.5 rounded-lg transition-colors shrink-0"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10m-11 9h12a2 2 0 002-2V7a2 2 0 00-2-2H6a2 2 0 00-2 2v11a2 2 0 002 2z" />
              </svg>
              {t(lang, 'reservations.viewSportsReservations')}
            </a>
            <a
              href={`/${lang}/community/sports/dashboard/`}
              class="inline-flex items-center gap-2 bg-white border border-warm-200 hover:border-ocean-300 text-warm-700 font-semibold px-5 py-2.5 rounded-lg transition-colors shrink-0"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 19h16M7 15l3-3 3 2 4-6" />
              </svg>
              {t(lang, 'reservations.viewTransparencyDashboard')}
            </a>
            {user && (
              <a
                href={`/${lang}/community/create/`}
                class="inline-flex items-center gap-2 bg-ocean-600 hover:bg-ocean-700 text-white font-semibold px-5 py-2.5 rounded-lg transition-colors shrink-0"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                {t(lang, 'community.createPost')}
              </a>
            )}
          </div>
        </div>

        <!-- Posts list (loaded client-side) -->
        <div id="posts-container" aria-live="polite" aria-busy="true">
          <div class="text-center py-12 text-warm-400">{t(lang, 'common.loading')}</div>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="space-y-6">
        <Leaderboard lang={lang} />
      </div>
    </div>
  </section>
</Page>

<script define:vars={{ lang, activeType, activeCategory, contactUrl, feedLabels }}>
  let currentType = activeType;
  let currentCategory = activeCategory;
  const HTML_ESCAPE_MAP = {
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;',
  };

  function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, (char) => HTML_ESCAPE_MAP[char]);
  }

  function formatLabel(value) {
    return escapeHtml(String(value ?? '').replace(/-/g, ' '));
  }

  const typeColors = {
    meetup: 'bg-ocean-100 text-ocean-800',
    'event-idea': 'bg-sand-100 text-sand-800',
    'partner-search': 'bg-coral-50 text-coral-700',
    discussion: 'bg-warm-100 text-warm-700',
  };

  function renderPostCard(p) {
    const postId = encodeURIComponent(String(p.id ?? ''));
    const title = escapeHtml(p.title);
    const body = String(p.body ?? '');
    const excerpt = escapeHtml(body.slice(0, 150));
    const excerptSuffix = body.length > 150 ? '...' : '';
    const authorName = escapeHtml(p.author_name);
    const createdAt = escapeHtml(new Date(p.created_at).toLocaleDateString(lang, {
      month: 'short',
      day: 'numeric',
    }));
    const eventDate = p.event_date
      ? `<span class="text-xs text-warm-500 shrink-0">${escapeHtml(new Date(p.event_date).toLocaleDateString(lang, { month: 'short', day: 'numeric' }))}${p.event_time ? ' · ' + escapeHtml(p.event_time) : ''}</span>`
      : '';
    const location = p.location
      ? `<div class="flex items-center gap-1.5 text-xs text-warm-500 mb-3"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>${escapeHtml(p.location)}</div>`
      : '';
    const meetupInfo = p.type === 'meetup'
      ? `<span>${escapeHtml(p.join_count)}${p.max_participants ? '/' + escapeHtml(p.max_participants) : ''} joined</span>`
      : '';

    return `
      <a href="/${lang}/community/${postId}/" class="block bg-white rounded-xl border border-warm-200 hover:border-ocean-300 hover:shadow-md transition-all duration-200 p-5 group">
        <div class="flex items-start justify-between gap-3 mb-3">
          <div class="flex flex-wrap gap-2">
            <span class="text-xs font-medium px-2 py-0.5 rounded-full ${typeColors[p.type] || 'bg-warm-100 text-warm-700'}">${formatLabel(p.type)}</span>
            <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-warm-50 text-warm-600">${formatLabel(p.category)}</span>
          </div>
          ${eventDate}
        </div>
        <h3 class="text-lg font-semibold text-ocean-900 group-hover:text-ocean-700 transition-colors mb-2 line-clamp-2">${title}</h3>
        <p class="text-warm-600 text-sm line-clamp-2 mb-4">${excerpt}${excerptSuffix}</p>
        ${location}
        <div class="flex items-center justify-between pt-3 border-t border-warm-100">
          <div class="flex items-center gap-1 text-xs text-warm-500"><span class="font-medium text-warm-700">${authorName}</span><span>·</span><span>${createdAt}</span></div>
          <div class="flex items-center gap-3 text-xs text-warm-500">
            ${meetupInfo}
            <span>${escapeHtml(p.comment_count)} comments</span>
            <span>${escapeHtml(p.views)} views</span>
          </div>
        </div>
      </a>`;
  }

  async function loadPosts() {
    const container = document.getElementById('posts-container');
    if (!container) return;
    container.setAttribute('aria-busy', 'true');
    container.innerHTML = `<div class="text-center py-12 text-warm-400">${escapeHtml(feedLabels.loading)}</div>`;

    const params = new URLSearchParams();
    if (currentType) params.set('type', currentType);
    if (currentCategory) params.set('category', currentCategory);

    try {
      const res = await fetch(`/api/posts/?${params}`);
      if (!res.ok) throw new Error('Community feed request failed');
      const data = await res.json();
      if (!Array.isArray(data.posts)) throw new Error('Community feed response is invalid');

      if (data.posts.length === 0) {
        container.innerHTML = `<div class="text-center py-12 text-warm-400">${escapeHtml(feedLabels.empty)}</div>`;
        return;
      }

      container.innerHTML = `<div class="space-y-4">${data.posts.map(renderPostCard).join('')}</div>`;
    } catch {
      container.innerHTML = `
        <div role="alert" class="rounded-xl border border-coral-200 bg-coral-50/60 px-5 py-6 sm:px-6">
          <div class="flex items-start gap-4">
            <div class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white text-coral-600 ring-1 ring-coral-200" aria-hidden="true">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3m0 4h.01M10.29 3.86l-7.82 13.55A2 2 0 004.2 20h15.6a2 2 0 001.73-3L13.71 3.86a2 2 0 00-3.42 0z" />
              </svg>
            </div>
            <div class="min-w-0 flex-1">
              <h2 class="font-semibold text-warm-900">${escapeHtml(feedLabels.errorTitle)}</h2>
              <p class="mt-1 text-sm leading-6 text-warm-600">${escapeHtml(feedLabels.errorDescription)}</p>
              <div class="mt-4 flex flex-wrap items-center gap-4">
                <button type="button" data-feed-retry class="inline-flex min-h-11 items-center justify-center rounded-lg bg-ocean-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-ocean-700 focus:outline-none focus:ring-2 focus:ring-ocean-500 focus:ring-offset-2">
                  ${escapeHtml(feedLabels.retry)}
                </button>
                <a href="${escapeHtml(contactUrl)}" class="inline-flex min-h-11 items-center text-sm font-semibold text-ocean-700 underline decoration-ocean-300 underline-offset-4 hover:text-ocean-900">
                  ${escapeHtml(feedLabels.contact)}
                </a>
              </div>
            </div>
          </div>
        </div>`;
      container.querySelector('[data-feed-retry]')?.addEventListener('click', loadPosts);
    } finally {
      container.setAttribute('aria-busy', 'false');
    }
  }

  // Filter clicks
  document.querySelectorAll('[data-filter]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const filterType = btn.getAttribute('data-filter');
      const value = btn.getAttribute('data-value');

      if (filterType === 'type') {
        currentType = value;
        document.querySelectorAll('[data-filter="type"]').forEach((b) => {
          b.className = b.getAttribute('data-value') === value
            ? 'px-3 py-1.5 text-sm rounded-full font-medium transition-colors bg-ocean-600 text-white'
            : 'px-3 py-1.5 text-sm rounded-full font-medium transition-colors bg-warm-100 text-warm-600 hover:bg-warm-200';
        });
      } else {
        currentCategory = value;
        document.querySelectorAll('[data-filter="category"]').forEach((b) => {
          b.className = b.getAttribute('data-value') === value
            ? 'px-3 py-1.5 text-sm rounded-full font-medium transition-colors bg-sand-500 text-white'
            : 'px-3 py-1.5 text-sm rounded-full font-medium transition-colors bg-warm-50 text-warm-500 hover:bg-warm-100';
        });
      }

      loadPosts();
    });
  });

  loadPosts();
</script>
