---
export const prerender = false;

import Page from '@/layouts/Page.astro';
import Button from '@/components/ui/Button.astro';
import ReservationTrustPanel from '@/components/community/ReservationTrustPanel.astro';
import type { Language } from '@/lib/i18n';
import { LANGUAGES, ROUTE_SEGMENTS } from '@/lib/i18n';
import { getTranslations, t } from '@/lib/translations';

const lang = Astro.params.lang as Language;
if (!LANGUAGES.includes(lang)) return Astro.redirect('/en/community/reservations/');

const translations = getTranslations(lang);
const alternates = Object.fromEntries(
  LANGUAGES.map((locale) => [locale, `/${locale}/community/reservations/`]),
) as Record<Language, string>;

const accessPoints = [
  t(lang, 'reservations.ruleFree'),
  t(lang, 'reservations.ruleWindow'),
  t(lang, 'reservations.ruleDailyLimit'),
  t(lang, 'reservations.rulePublic'),
];

const quickStartSteps = [
  t(lang, 'reservations.quickStartStep1'),
  t(lang, 'reservations.quickStartStep2'),
  t(lang, 'reservations.quickStartStep3'),
  t(lang, 'reservations.quickStartStep4'),
];

const fairnessPoints = [
  t(lang, 'reservations.fairnessPointPublic'),
  t(lang, 'reservations.fairnessPointSignin'),
  t(lang, 'reservations.fairnessPointClosures'),
];

const contactUrl = `/${lang}/${ROUTE_SEGMENTS.contact[lang]}/`;
---

<Page
  title={t(lang, 'reservations.title')}
  description={t(lang, 'reservations.subtitle')}
  lang={lang}
  translations={translations}
  alternates={alternates}
>
  <section class="container-page py-10">
    <div class="max-w-4xl">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-ocean-600 mb-3">
        {t(lang, 'reservations.publicSchedule')}
      </p>
      <h1 class="text-3xl md:text-5xl font-display text-ocean-900 mb-4">
        {t(lang, 'reservations.title')}
      </h1>
      <p class="text-lg text-warm-600 max-w-3xl">
        {t(lang, 'reservations.subtitle')}
      </p>

      <div class="mt-6 flex flex-wrap gap-3">
        <Button href={`/${lang}/play/`} variant="primary" size="lg">
          {t(lang, 'reservations.quickStartTitle')}
        </Button>
        <Button href={`/${lang}/community/reservations/rules/`} variant="secondary" size="lg">
          {t(lang, 'reservations.rulesCta')}
        </Button>
        <Button href={`/${lang}/community/start/`} variant="outline" size="lg">
          {t(lang, 'community.startCta')}
        </Button>
        <Button href={contactUrl} variant="outline" size="lg">
          {t(lang, 'reservations.contactCta')}
        </Button>
      </div>
    </div>

    <div class="mt-6">
      <ReservationTrustPanel lang={lang} />
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-4 gap-4 mt-6">
      {accessPoints.map((point) => (
        <article class="rounded-2xl border border-ocean-100 bg-ocean-50 px-5 py-5">
          <p class="text-sm leading-7 text-warm-700">{point}</p>
        </article>
      ))}
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] gap-6 mt-6">
      <article class="bg-white rounded-2xl border border-warm-200 p-6">
        <h2 class="text-2xl font-semibold text-ocean-900">{t(lang, 'reservations.quickStartHowTitle')}</h2>
        <div class="mt-5 grid grid-cols-1 md:grid-cols-2 gap-4">
          {quickStartSteps.map((step, index) => (
            <div class="rounded-2xl border border-warm-100 bg-warm-50 px-5 py-5">
              <div class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-white text-sm font-semibold text-ocean-700 border border-ocean-200">
                {index + 1}
              </div>
              <p class="mt-4 text-sm leading-7 text-warm-700">{step}</p>
            </div>
          ))}
        </div>
      </article>

      <div class="space-y-6">
        <article class="bg-white rounded-2xl border border-warm-200 p-6">
          <h2 class="text-xl font-semibold text-ocean-900">{t(lang, 'reservations.pilotInventoryTitle')}</h2>
          <p class="mt-3 text-sm leading-7 text-warm-700">
            {t(lang, 'reservations.pilotInventorySummary')}
          </p>
          <p class="mt-3 text-sm leading-7 text-warm-700">
            {t(lang, 'reservations.pilotInventoryNote')}
          </p>
        </article>

        <article class="bg-sand-50 rounded-2xl border border-sand-200 p-6">
          <h2 class="text-xl font-semibold text-ocean-900">{t(lang, 'reservations.fairnessTitle')}</h2>
          <p class="mt-3 text-sm leading-7 text-warm-700">
            {t(lang, 'reservations.fairnessDescription')}
          </p>
          <ul class="mt-4 space-y-3 text-sm text-warm-700">
            {fairnessPoints.map((point) => (
              <li class="rounded-xl border border-sand-100 bg-white/80 px-4 py-3">{point}</li>
            ))}
          </ul>
        </article>
      </div>
    </div>

    <div class="bg-white rounded-2xl border border-warm-200 p-6 mt-6">
      <h2 class="text-xl font-semibold text-ocean-900">{t(lang, 'reservations.pilotFutureTitle')}</h2>
      <p class="mt-3 text-sm leading-7 text-warm-700">
        {t(lang, 'reservations.pilotFutureBody')}
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <Button href={`/${lang}/community/reservations/dashboard/`} variant="secondary">
          {t(lang, 'reservations.viewTransparencyDashboard')}
        </Button>
        <Button href={`/${lang}/play/materials/`} variant="outline">
          {t(lang, 'reservations.pilotKitCta')}
        </Button>
      </div>
    </div>
  </section>
</Page>
