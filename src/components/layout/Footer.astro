---
import type { Language } from '@/lib/i18n';
import { getLocalizedUrl, getHomeUrl } from '@/lib/i18n';
import { getCollection } from 'astro:content';
import Logo from '@/components/ui/Logo.astro';

interface Props {
  lang: Language;
  translations: Record<string, string>;
}

const { lang, translations } = Astro.props;
const currentYear = new Date().getFullYear();
const pages = await getCollection('pages');
const pageLinks = new Map(
  pages.map((page) => [page.data.id || page.id, `/${lang}/${page.data.slug[lang]}/`]),
);

function getStaticPageUrl(pageId: string): string {
  return pageLinks.get(pageId) || getHomeUrl(lang);
}
---

<footer class="bg-ocean-900 text-cream mt-16">
  <div class="container-page py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- About -->
      <div class="md:col-span-2">
        <a href={getHomeUrl(lang)} class="inline-flex items-center gap-2.5 text-2xl font-display text-white leading-none hover:text-cream transition-colors duration-200">
          <Logo variant="white" class="w-9 h-9" />
          Žnjan
        </a>
        <p class="mt-4 text-cream/70 text-sm leading-relaxed max-w-md">
          {translations['footer.description'] || 'The definitive guide to Žnjan Beach in Split, Croatia.'}
        </p>
        <div class="mt-5 flex items-center gap-3">
          <a
            href="https://www.instagram.com/znjan.beach/"
            target="_blank"
            rel="noopener"
            aria-label="Instagram"
            class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center text-cream hover:bg-coral-400 transition-colors duration-200"
          >
            <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
            </svg>
          </a>
          <a
            href="https://www.google.com/maps/place/%C5%BDnjan,+Split"
            target="_blank"
            rel="noopener"
            aria-label="Map"
            class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center text-cream hover:bg-coral-400 transition-colors duration-200"
          >
            <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="font-semibold text-white mb-4">{translations['footer.explore'] || 'Explore'}</h3>
        <ul class="space-y-2">
          <li>
            <a href={getLocalizedUrl(lang, 'guides')} class="text-cream/70 hover:text-white text-sm transition-colors duration-200">
              {translations['nav.guides'] || 'Guides'}
            </a>
          </li>
          <li>
            <a href={getLocalizedUrl(lang, 'articles')} class="text-cream/70 hover:text-white text-sm transition-colors duration-200">
              {translations['nav.articles'] || 'Articles'}
            </a>
          </li>
          <li>
            <a href={getLocalizedUrl(lang, 'places')} class="text-cream/70 hover:text-white text-sm transition-colors duration-200">
              {translations['nav.places'] || 'Places'}
            </a>
          </li>
          <li>
            <a href={getLocalizedUrl(lang, 'activities')} class="text-cream/70 hover:text-white text-sm transition-colors duration-200">
              {translations['nav.activities'] || 'Activities'}
            </a>
          </li>
          <li>
            <a href={getLocalizedUrl(lang, 'beach-areas')} class="text-cream/70 hover:text-white text-sm transition-colors duration-200">
              {translations['nav.beachAreas'] || 'Beach Areas'}
            </a>
          </li>
          <li>
            <a href={getLocalizedUrl(lang, 'events')} class="text-cream/70 hover:text-white text-sm transition-colors duration-200">
              {translations['nav.events'] || 'Events'}
            </a>
          </li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="font-semibold text-white mb-4">{translations['footer.legal'] || 'Legal'}</h3>
        <ul class="space-y-2">
          <li>
            <a href={getStaticPageUrl('about')} class="text-cream/70 hover:text-white text-sm transition-colors duration-200">
              {translations['nav.about'] || 'About'}
            </a>
          </li>
          <li>
            <a href={getStaticPageUrl('contact')} class="text-cream/70 hover:text-white text-sm transition-colors duration-200">
              {translations['nav.contact'] || 'Contact'}
            </a>
          </li>
          <li>
            <a href={getStaticPageUrl('privacy')} class="text-cream/70 hover:text-white text-sm transition-colors duration-200">
              {translations['common.privacyPolicy'] || 'Privacy Policy'}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom -->
    <div class="mt-12 pt-8 border-t border-ocean-700/50 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-cream/60 text-sm">
        &copy; {currentYear} Znjan.com. {translations['common.copyright'] || 'All rights reserved.'}
      </p>
      <p class="text-cream/40 text-xs">
        Split, Croatia
      </p>
    </div>
  </div>
</footer>
