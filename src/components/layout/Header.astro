---
import type { Language } from '@/lib/i18n';
import { ROUTE_SEGMENTS, getHomeUrl, getLocalizedUrl, DEFAULT_LANGUAGE } from '@/lib/i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import SearchDialog from '@/components/widgets/SearchDialog.astro';
import Logo from '@/components/ui/Logo.astro';

interface Props {
  lang: Language;
  translations: Record<string, string>;
  alternates?: Partial<Record<Language, string>>;
}

const { lang, translations, alternates } = Astro.props;

const navItems = [
  { key: 'guides', label: translations['nav.guides'] || 'Guides' },
  { key: 'places', label: translations['nav.places'] || 'Places' },
  { key: 'activities', label: translations['nav.activities'] || 'Activities' },
  { key: 'beach-areas', label: translations['nav.beachAreas'] || 'Beach Areas' },
  { key: 'events', label: translations['nav.events'] || 'Events' },
  { key: 'community', label: translations['nav.community'] || 'Community' },
];
---

<header class="sticky top-0 z-50 bg-ocean-800/95 backdrop-blur-sm border-b border-ocean-900/20">
  <div class="container-page">
    <nav class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href={getHomeUrl(lang)} class="flex items-center gap-2.5 text-white font-display text-2xl leading-none hover:text-cream transition-colors duration-200">
        <Logo variant="white" class="w-9 h-9" />
        <span>Žnjan</span>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden md:flex items-center gap-6">
        {navItems.map((item) => (
          <a
            href={getLocalizedUrl(lang, item.key)}
            class="text-sm font-medium text-cream/80 hover:text-white transition-colors duration-200"
          >
            {item.label}
          </a>
        ))}
        <SearchDialog lang={lang} />
        <LanguageSwitcher lang={lang} alternates={alternates} />
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 text-cream/80 hover:text-white focus:outline-none focus:ring-2 focus:ring-cream/30 focus:ring-offset-2 focus:ring-offset-ocean-800 transition-colors duration-200"
        aria-label={translations['nav.menu'] || 'Menu'}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </nav>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-ocean-800 border-t border-ocean-700/50">
    <div class="container-page py-4 space-y-3">
      {navItems.map((item) => (
        <a
          href={getLocalizedUrl(lang, item.key)}
          class="block py-2 text-cream/80 hover:text-white font-medium transition-colors duration-200"
        >
          {item.label}
        </a>
      ))}
      <div class="pt-3 border-t border-ocean-700/50 flex items-center gap-4">
        <SearchDialog lang={lang} />
        <LanguageSwitcher lang={lang} alternates={alternates} />
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const isHidden = menu?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!isHidden));
  });
  // Auto-close mobile menu when a nav link is clicked
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
