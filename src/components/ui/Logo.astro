---
/**
 * Logo — Žnjan "Horizon Sun" mark (a setting sun over Adriatic ripples in a navy ring).
 * `variant="white"` renders the reversed line-art for dark / photo backgrounds.
 * `variant="color"` renders the full-colour badge for light backgrounds.
 */
interface Props {
  variant?: 'color' | 'white';
  class?: string;
}

const { variant = 'color', class: className } = Astro.props;
---

{variant === 'white' ? (
  <svg class:list={['block', className]} viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Žnjan">
    <defs>
      <clipPath id="zBadgeW"><circle cx="60" cy="60" r="56" /></clipPath>
    </defs>
    <g clip-path="url(#zBadgeW)">
      <circle cx="60" cy="48" r="15" fill="none" stroke="#FFFFFF" stroke-width="3" />
      <path d="M18 62 Q 39 57 60 62 T 102 62" stroke="#FFFFFF" stroke-width="3.4" stroke-linecap="round" fill="none" />
      <path d="M23 71 Q 41.5 75.5 60 71 T 97 71" stroke="#FFFFFF" stroke-width="3.4" stroke-linecap="round" fill="none" opacity="0.85" />
      <path d="M29 80 Q 45 75.5 60 80 T 91 80" stroke="#FFFFFF" stroke-width="3.4" stroke-linecap="round" fill="none" />
      <path d="M37 89 Q 50 92.5 60 89 T 83 89" stroke="#FFFFFF" stroke-width="3.4" stroke-linecap="round" fill="none" opacity="0.85" />
    </g>
    <circle cx="60" cy="60" r="56" fill="none" stroke="#FFFFFF" stroke-width="3.5" />
  </svg>
) : (
  <svg class:list={['block', className]} viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Žnjan">
    <defs>
      <clipPath id="zBadge"><circle cx="60" cy="60" r="56" /></clipPath>
    </defs>
    <circle cx="60" cy="60" r="56" fill="#FBF6EC" />
    <g clip-path="url(#zBadge)">
      <circle cx="60" cy="48" r="15" fill="#F2B35A" stroke="#0F2D3D" stroke-width="1.4" />
      <path d="M18 62 Q 39 57 60 62 T 102 62" stroke="#1F6C7E" stroke-width="3.4" stroke-linecap="round" fill="none" />
      <path d="M23 71 Q 41.5 75.5 60 71 T 97 71" stroke="#67B7BC" stroke-width="3.4" stroke-linecap="round" fill="none" />
      <path d="M29 80 Q 45 75.5 60 80 T 91 80" stroke="#1F6C7E" stroke-width="3.4" stroke-linecap="round" fill="none" />
      <path d="M37 89 Q 50 92.5 60 89 T 83 89" stroke="#67B7BC" stroke-width="3.4" stroke-linecap="round" fill="none" />
    </g>
    <circle cx="60" cy="60" r="56" fill="none" stroke="#0F2D3D" stroke-width="3.5" />
  </svg>
)}
