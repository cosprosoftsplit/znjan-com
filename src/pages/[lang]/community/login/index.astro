---
export const prerender = false;

import Page from '@/layouts/Page.astro';
import type { Language } from '@/lib/i18n';
import { LANGUAGES } from '@/lib/i18n';
import { getTranslations, t } from '@/lib/translations';

const lang = Astro.params.lang as Language;
if (!LANGUAGES.includes(lang)) return Astro.redirect('/en/community/login/');

const translations = getTranslations(lang);
const user = Astro.locals.user;
if (user) return Astro.redirect(`/${lang}/community/`);

const errorParam = Astro.url.searchParams.get('error');
const successParam = Astro.url.searchParams.get('success');
---

<Page
  title={t(lang, 'auth.loginTitle')}
  description={t(lang, 'auth.loginDescription')}
  lang={lang}
  translations={translations}
  noIndex={true}
>
  <div class="container-page py-16 max-w-md mx-auto">
    <div class="bg-white rounded-2xl shadow-lg p-8">
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-ocean-100 rounded-full mb-4">
          <svg class="w-8 h-8 text-ocean-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </div>
        <h1 class="text-2xl font-display text-ocean-900 mb-2">{t(lang, 'auth.loginTitle')}</h1>
        <p class="text-warm-600">{t(lang, 'auth.loginSubtitle')}</p>
      </div>

      {errorParam && (
        <div class="bg-coral-50 border border-coral-200 text-coral-800 px-4 py-3 rounded-lg mb-6 text-sm">
          {errorParam === 'invalid-token' ? t(lang, 'auth.errorInvalidToken') :
           errorParam === 'missing-token' ? t(lang, 'auth.errorMissingToken') :
           t(lang, 'auth.errorGeneric')}
        </div>
      )}

      {successParam === 'sent' && (
        <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg mb-6 text-sm" id="success-msg">
          {t(lang, 'auth.emailSent')}
        </div>
      )}

      <form id="login-form" class="space-y-4">
        <div>
          <label for="email" class="block text-sm font-medium text-warm-700 mb-1.5">
            {t(lang, 'auth.emailLabel')}
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder={t(lang, 'auth.emailPlaceholder')}
            class="w-full px-4 py-3 border border-warm-300 rounded-lg focus:ring-2 focus:ring-ocean-500 focus:border-ocean-500 transition-colors"
          />
        </div>

        <button
          type="submit"
          id="submit-btn"
          class="w-full bg-ocean-600 hover:bg-ocean-700 text-white font-semibold py-3 px-4 rounded-lg transition-colors duration-200 disabled:opacity-50 disabled:cursor-not-allowed"
        >
          {t(lang, 'auth.sendMagicLink')}
        </button>
      </form>

      <p class="text-center text-warm-500 text-xs mt-6">{t(lang, 'auth.noPassword')}</p>
    </div>
  </div>
</Page>

<script define:vars={{ lang }}>
  const form = document.getElementById('login-form');
  const btn = document.getElementById('submit-btn');
  const emailInput = document.getElementById('email');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btn.textContent = '...';

    try {
      const res = await fetch('/api/auth/login/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: emailInput.value, lang }),
      });

      const data = await res.json();
      if (res.ok && data.verifyUrl) {
        // Auto-redirect to verify URL (instant login, no email needed)
        window.location.href = data.verifyUrl;
        return;
      } else {
        alert(data.error || 'Something went wrong');
        btn.disabled = false;
        btn.textContent = 'Send Magic Link';
      }
    } catch {
      alert('Network error. Please try again.');
      btn.disabled = false;
      btn.textContent = 'Send Magic Link';
    }
  });
</script>
