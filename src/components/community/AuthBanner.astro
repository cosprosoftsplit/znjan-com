---
import type { Language } from '@/lib/i18n';
import { t } from '@/lib/translations';
import type { User } from '@/lib/auth';
import { getLevelInfo, LEVELS } from '@/lib/gamification';

interface Props {
  lang: Language;
  user: User | null | undefined;
}

const { lang, user } = Astro.props;
const levelInfo = user ? getLevelInfo(user.points) : null;
---

{user ? (
  <div class="bg-white rounded-xl border border-warm-200 p-4 flex items-center justify-between gap-4 flex-wrap">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-full bg-ocean-100 flex items-center justify-center text-ocean-700 font-bold text-lg">
        {user.display_name.charAt(0).toUpperCase()}
      </div>
      <div>
        <div class="font-semibold text-ocean-900">{user.display_name}</div>
        <div class="text-xs text-warm-500">
          {t(lang, 'gamification.level')} {user.level} · {user.points} {t(lang, 'gamification.points')}
        </div>
      </div>
    </div>
    <div class="flex items-center gap-3">
      <a
        href={`/${lang}/community/profile/${user.id}/`}
        class="text-sm text-ocean-600 hover:text-ocean-800 font-medium transition-colors"
      >
        {t(lang, 'profile.title')}
      </a>
      <button
        id="logout-btn"
        class="text-sm text-warm-500 hover:text-coral-600 font-medium transition-colors"
      >
        {t(lang, 'auth.signOut')}
      </button>
    </div>
  </div>
) : (
  <div class="bg-ocean-50 rounded-xl border border-ocean-200 p-4 flex items-center justify-between gap-4 flex-wrap">
    <p class="text-ocean-800 text-sm">{t(lang, 'community.loginToParticipate')}</p>
    <a
      href={`/${lang}/community/login/`}
      class="inline-flex items-center gap-2 bg-ocean-600 hover:bg-ocean-700 text-white text-sm font-semibold px-4 py-2 rounded-lg transition-colors"
    >
      {t(lang, 'auth.signIn')}
    </a>
  </div>
)}

<script>
  document.getElementById('logout-btn')?.addEventListener('click', async () => {
    await fetch('/api/auth/logout/', { method: 'POST' });
    window.location.reload();
  });
</script>
